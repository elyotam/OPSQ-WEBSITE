# Copy to .env.local and fill in. Never commit real values.

# SMTP connection used to email demo requests, e.g. smtps://USER:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=

# Inbox that receives demo requests
DEMO_INBOX=

# Optional sender, e.g. "OpsQ <no-reply@your-domain.com>". Defaults to DEMO_INBOX.
MAIL_FROM=

# Optional: a form service that stores and emails leads (works on the static build too),
# e.g. https://formspree.io/f/XXXX or https://api.web3forms.com/submit
NEXT_PUBLIC_LEAD_ENDPOINT=
# Only if the service needs a public access key (Web3Forms does)
NEXT_PUBLIC_LEAD_ACCESS_KEY=
